{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "npm run check && astro build",
    "preview": "astro preview",
    "format": "prettier --write . !lib/mongfontbuilder/data/*.json !tests/data/*.json"
  },
  "engines": {
    "node": "^24.11.0"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource/noto-sans-mongolian": "5.3.0",
    "@types/node": "26.4.1",
    "@unicode/unicode-17.0.0": "2.0.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.0"
  },
  "overrides": {
    "lodash": "4.17.23"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.mdx",
        "options": {
          "printWidth": 10000
        }
      },
      {
        "files": "*.astro",
        "options": {
          "plugins": [
            "prettier-plugin-astro"
          ],
          "parser": "astro",
          "printWidth": 10000
        }
      },
      {
        "files": "*.svelte",
        "options": {
          "plugins": [
            "prettier-plugin-svelte"
          ],
          "parser": "svelte",
          "printWidth": 10000
        }
      }
    ]
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.42.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "astro": "^7.2.10",
    "typescript": "6.0.3"
  }
}
